ENVIRONMENT=local

# API del Clima (OpenWeatherMap)
# Obtén tu clave gratis en: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=tu_api_key_aqui
CIUDAD_RESTAURANTE=Santiago,CL

# URL del frontend Next.js (para CORS del agente)
FRONTEND_URL=http://localhost:3000

# Credenciales de producción
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_USER=usuario_produccion
PROD_DB_PASSWORD=password_produccion
PROD_DB_NAME=nombre_base_datos

# Credenciales de desarrollo local
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASSWORD=
DEV_DB_NAME=gastro_sys_fusion
